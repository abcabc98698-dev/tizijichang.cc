---
import { getCollection } from 'astro:content';
import MarketingLayout from '../../../components/MarketingLayout.astro';
import { SITE_CONFIG } from '../../../config/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  const byAuthor = new Map<string, typeof posts>();
  for (const post of posts) {
    const slug = post.data.author.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fa5]+/g, '-').replace(/^-|-$/g, '');
    if (!byAuthor.has(slug)) byAuthor.set(slug, []);
    byAuthor.get(slug)!.push(post);
  }
  return Array.from(byAuthor.entries()).map(([author, authorPosts]) => ({
    params: { author },
    props: {
      authorName: authorPosts[0].data.author,
      posts: authorPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { authorName, posts } = Astro.props;
const { author } = Astro.params;

function formatDate(date: Date): string {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}

function readingTime(body: string | undefined): number {
  if (!body) return 1;
  const chars = body.replace(/\s+/g, '').length;
  return Math.max(1, Math.round(chars / 400));
}
---

<MarketingLayout
  title={`${authorName} 的专栏文章 — ${SITE_CONFIG.name}`}
  description={`${authorName} 在 ${SITE_CONFIG.name} 上发表的专线机场评测与网络技术文章。`}
  canonicalPath={`/blog/author/${author}/`}
  robots="noindex, follow"
  activeNav="blog"
>
  <header class="page-hero-section">
    <div class="container">
      <a href="/blog/" class="blog-back">&larr; 返回所有专栏文章</a>
      <div class="section-header" style="margin-top:1rem;">
        <span class="overline">专栏作者档案 · Author Portfolio & Laboratory</span>
        <h1>{authorName}</h1>
        <p class="section-desc">已发表 <strong>{posts.length}</strong> 篇专线机场深度测评与网络协议实测指南。</p>
      </div>

      <!-- 作者 E-E-A-T 专栏背景与实验室配置 -->
      <div class="author-cred-box" style="margin-top:1.5rem;padding:1.25rem 1.5rem;background:var(--card-bg, #161b22);border:1px solid var(--border-color, #30363d);border-radius:8px;">
        <h3 style="font-size:1.05rem;margin:0 0 0.5rem;color:var(--accent);">🔬 评测实验室背景与技术准则</h3>
        <p style="font-size:0.88rem;color:var(--text-secondary);line-height:1.6;margin:0 0 0.75rem;">
          {authorName} 系 <strong>{SITE_CONFIG.name}</strong> 核心网络测量与数据工程组，专注于跨境专线骨干拓扑剖析、BGP Anycast 智能路由压测、以及主流代理协议（Shadowsocks, VLESS, Hysteria 2）在晚高峰拥塞场景下的真实吞吐与抖动监测。
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;font-size:0.82rem;color:var(--text-secondary);">
          <span>📡 <strong>测速探针环境：</strong>广州电信 1000M / 上海联通 500M / 成都移动 1000M 物理千兆专线</span>
          <span>⚡ <strong>测试基准：</strong>每日晚高峰 (20:00 - 23:00) 连续抓包与 4K/8K 码率压测</span>
          <span>🛡️ <strong>中立承诺：</strong>数据 100% 独立实测，绝无商业充值干预测试结果</span>
        </div>
      </div>
    </div>
  </header>

  <div class="blog-body-wrap">
    <div class="container">
      <div class="blog-cards-stack">
        {posts.map((post) => (
          <article class="blog-article-card">
            <div class="blog-card-meta">
              <span class="meta-item">
                <time datetime={post.data.date.toISOString()}>📅 {formatDate(post.data.date)}</time>
              </span>
              <span class="meta-sep">/</span>
              <span class="meta-item">⏱️ 约 {readingTime(post.body)} 分钟阅读</span>
              <span class="meta-sep">/</span>
              <span class="meta-item">✍️ {post.data.author}</span>
            </div>

            <h2 class="blog-card-title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>

            <p class="blog-card-desc">{post.data.description}</p>

            <div class="blog-card-footer">
              <div class="blog-tags">
                {post.data.tags.map((tag) => (
                  <span class="blog-tag">{tag}</span>
                ))}
              </div>

              <a href={`/blog/${post.id}/`} class="blog-read-btn">
                阅读深度全文 &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <style>
    .blog-back {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: var(--accent);
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 600;
      transition: transform 0.15s ease;
    }

    .blog-back:hover {
      transform: translateX(-2px);
    }

    .blog-body-wrap {
      padding: 1.5rem 0 4.5rem;
    }

    .blog-cards-stack {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .blog-article-card {
      background: var(--bg-elevated);
      border: 1px solid var(--line);
      border-left: 4px solid var(--line-strong);
      border-radius: var(--radius-md, 4px);
      padding: 1.65rem 1.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    }

    .blog-article-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
      border-color: var(--line-strong);
      border-left-color: var(--accent);
    }

    .blog-card-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.55rem;
      font-size: 0.8rem;
      color: var(--muted);
      font-family: var(--mono);
    }

    .meta-sep {
      color: var(--line-strong);
      opacity: 0.6;
    }

    .blog-card-title {
      font-size: clamp(1.2rem, 2.5vw, 1.45rem);
      font-weight: 700;
      margin: 0.15rem 0 0.35rem;
      line-height: 1.42;
      letter-spacing: -0.02em;
    }

    .blog-card-title a {
      color: var(--ink);
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .blog-card-title a:hover {
      color: var(--accent);
    }

    .blog-card-desc {
      font-size: 0.92rem;
      color: var(--ink-soft);
      line-height: 1.65;
      margin: 0 0 0.5rem;
    }

    .blog-card-footer {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-top: 0.5rem;
      padding-top: 0.95rem;
      border-top: 1px solid var(--line);
    }

    .blog-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .blog-tag {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--radius-sm, 2px);
      padding: 0.2rem 0.55rem;
      font-size: 0.74rem;
      font-family: var(--mono);
      color: var(--muted);
      font-weight: 600;
      text-decoration: none;
      transition: all 0.15s ease;
    }

    .blog-tag:hover {
      border-color: var(--accent);
      color: var(--accent);
      background: var(--accent-soft);
    }

    .blog-read-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--accent);
      text-decoration: none;
      padding: 0.42rem 0.9rem;
      border: 1px solid var(--accent);
      border-radius: var(--radius-sm, 2px);
      background: var(--accent-soft);
      transition: all 0.15s ease;
      white-space: nowrap;
    }

    .blog-read-btn:hover {
      background: var(--accent);
      color: #0c0c0b;
      transform: translateX(2px);
    }
  </style>
</MarketingLayout>
