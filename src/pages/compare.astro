---
import MarketingLayout from '../components/MarketingLayout.astro';
import { SITE_CONFIG } from '../config/site';
import { AIRPORT_BRANDS } from '../data/brands';

const title = `42 家梯子机场参数、五地测速带宽与流媒体解锁横评大表 (2026) — ${SITE_CONFIG.name}`;
const description = `一表对比 42 家梯子机场核心指标：涵盖 #1 光速云等品牌的月付/年付/永久套餐起步价、优惠券码、IEPL/IPLC 专线类型、VLESS/Trojan/Hysteria2 协议、五地晚高峰延迟与下载带宽，以及 17 份真实测速图库。`;

const measuredBrands = AIRPORT_BRANDS.filter((b) => Boolean(b.speedtest.screenshot));

const statusTextMap = {
  measured: { label: 'Measured 实测', cls: 'yes' },
  vendor: { label: 'Vendor 官方', cls: 'partial' },
  historical: { label: 'Historical 历史', cls: 'no' },
  unverified: { label: 'Unverified 待核', cls: 'no' },
};

const clientShortMap = {
  both: '自研端 + Clash/小火箭',
  'third-party': 'Clash / 小火箭 / v2rayN',
  exclusive: '官方专属客户端免配置',
  unverified: '待核实',
};

function getRegionSpeed(brand: typeof AIRPORT_BRANDS[number], keyword: string) {
  const found = brand.speedtest.nodes.find((n) => n.region.includes(keyword));
  if (!found) return '—';
  return `${found.download} (${found.latency})`;
}
---

<MarketingLayout
  title={title}
  description={description}
  canonicalPath="/compare/"
  activeNav="compare"
>
  <header class="page-hero-section">
    <div class="container">
      <span class="overline">42 Brands Benchmark Matrix · 全量参数与实测横评</span>
      <h1>42 家梯子机场参数、五地测速与解锁横评大表</h1>
      <p class="hero-sub">
        将全站 42 家机场的「起步月均价、永久/不限时流量包、骨干专线类型、香港/日本/新加坡/美国实测吞吐量、ChatGPT 与 Netflix 4K 解锁状态」汇总于同一张可筛选对比矩阵，助您拒绝盲狙。
      </p>
    </div>
  </header>

  <!-- 顶部核心指标概览 -->
  <section class="compare-summary" style="padding-bottom: 1rem;">
    <div class="container">
      <div class="compare-cards">
        <div class="compare-card highlight">
          <p class="compare-card-tag">年度榜首 · 全能基准线</p>
          <h2 style="font-size:1.75rem;margin:0.3rem 0;color:var(--accent);">#1 光速云</h2>
          <p style="color:var(--text-secondary);font-size:0.88rem;margin:0;">
            ¥99/年 (折¥8.25/月) &amp; ¥147/247GB 永久包 · IEPL+企业内网双专线 · 优惠码 <code>AMM</code>
          </p>
        </div>
        <div class="compare-card">
          <p class="compare-card-tag">实测图库覆盖</p>
          <h2 style="font-size:1.75rem;margin:0.3rem 0;color:var(--accent);">17 家实测原图</h2>
          <p style="color:var(--text-secondary);font-size:0.88rem;margin:0;">
            2026-10 最新采集 Miaoko 拓扑与多地区延迟/峰值吞吐量实测报告
          </p>
        </div>
        <div class="compare-card">
          <p class="compare-card-tag">最低月均门槛</p>
          <h2 style="font-size:1.75rem;margin:0.3rem 0;color:var(--accent);">¥5.6 ～ ¥8.25/月</h2>
          <p style="color:var(--text-secondary);font-size:0.88rem;margin:0;">
            涵盖优云 (¥5.6)、极连云 (¥6)、青云梯 (¥8) 与光速云轻量年付 (¥8.25)
          </p>
        </div>
        <div class="compare-card">
          <p class="compare-card-tag">数据核验与透明分级</p>
          <h2 style="font-size:1.75rem;margin:0.3rem 0;color:var(--accent);">4 级状态标注</h2>
          <p style="color:var(--text-secondary);font-size:0.88rem;margin:0;">
            严格区分 Measured 实测 / Vendor 官方 / Historical 历史 / Unverified 待核实
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 42家全量横评矩阵表 -->
  <section class="compare-matrix">
    <div class="container">
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:1rem;margin-bottom:1rem;">
        <div>
          <h2>一、42 家机场核心参数与五地节点速度对比矩阵</h2>
          <p class="section-sub" style="margin-bottom:0;">
            提示：表格支持左右滑动；点击品牌名称可进入独立评测页查看完整套餐表与网络拓扑。官网按钮含推广链接（<code>rel="nofollow sponsored"</code>），不影响您的购买价格。
          </p>
        </div>
        <div class="filter-pills" id="matrix-filter-pills">
          <button class="pill active" data-tier="all">全部 42 家</button>
          <button class="pill" data-tier="top10">🏆 Top 10 主推</button>
          <button class="pill" data-tier="measured">📸 含实测图 (17)</button>
          <button class="pill" data-tier="active">⚡ 当期活跃 (#1-#28)</button>
          <button class="pill" data-tier="historical">📁 历史归档 (#29-#42)</button>
        </div>
      </div>

      <div class="matrix-wrap">
        <table class="matrix-table" id="brands-matrix-table">
          <thead>
            <tr>
              <th>排名 / 品牌</th>
              <th>数据状态</th>
              <th class="col-highlight">起步价格 / 流量</th>
              <th>专属优惠码</th>
              <th>骨干线路 / 协议</th>
              <th>客户端支持</th>
              <th>香港节点参考</th>
              <th>新加坡 / 日本参考</th>
              <th>ChatGPT / Netflix</th>
              <th>评测与官网</th>
            </tr>
          </thead>
          <tbody>
            {AIRPORT_BRANDS.map((brand) => {
              const st = statusTextMap[brand.speedtest.dataStatus];
              const hasShot = Boolean(brand.speedtest.screenshot);
              const rowTags = [
                brand.tier,
                brand.tier !== 'historical' ? 'active' : '',
                hasShot ? 'measured' : '',
              ]
                .filter(Boolean)
                .join(' ');

              return (
                <tr
                  class={`matrix-row ${brand.rank === 1 ? 'row-top1' : ''}`}
                  data-tags={rowTags}
                >
                  <td>
                    <div style="display:flex;align-items:center;gap:0.45rem;white-space:nowrap;">
                      <span
                        style={`display:inline-block;padding:0.1rem 0.45rem;border-radius:5px;font-weight:700;font-size:0.75rem;background:${brand.accentColor}22;color:${brand.accentColor};`}
                      >
                        #{brand.rank}
                      </span>
                      <a href={`/brands/${brand.slug}/`} style="font-weight:700;color:var(--text-primary);text-decoration:none;">
                        {brand.name}
                      </a>
                    </div>
                    <div style="font-size:0.73rem;color:var(--text-secondary);">{brand.enName}</div>
                  </td>
                  <td style="white-space:nowrap;">
                    <span class={st.cls}>{st.label}</span>
                  </td>
                  <td class="col-highlight" style="white-space:nowrap;">
                    <strong>{brand.startingPrice}</strong>
                    <div style="font-size:0.75rem;color:var(--text-secondary);">{brand.entryTraffic}</div>
                  </td>
                  <td style="white-space:nowrap;">
                    {brand.promoCode ? (
                      <code style="color:#10b981;font-weight:700;">{brand.promoCode}</code>
                    ) : (
                      <span style="color:var(--text-secondary);font-size:0.78rem;">官网直减/无</span>
                    )}
                  </td>
                  <td>
                    <div style="font-weight:600;font-size:0.82rem;">{brand.lineType.split('（')[0]}</div>
                    <div style="font-size:0.74rem;color:var(--text-secondary);">{brand.protocols.join(' / ')}</div>
                  </td>
                  <td style="font-size:0.8rem;">{clientShortMap[brand.clientSupport]}</td>
                  <td style="font-family:var(--font-mono,monospace);font-size:0.78rem;white-space:nowrap;">
                    {getRegionSpeed(brand, '香港')}
                  </td>
                  <td style="font-family:var(--font-mono,monospace);font-size:0.78rem;white-space:nowrap;">
                    {getRegionSpeed(brand, '新加坡') !== '—' ? getRegionSpeed(brand, '新加坡') : getRegionSpeed(brand, '日本')}
                  </td>
                  <td style="white-space:nowrap;font-size:0.78rem;">
                    <span class={brand.unlock.chatgpt === 'Supported' ? 'yes' : 'partial'}>
                      AI: {brand.unlock.chatgpt}
                    </span>
                    <br />
                    <span class={brand.unlock.netflix === 'Supported' ? 'yes' : 'partial'}>
                      NF: {brand.unlock.netflix}
                    </span>
                  </td>
                  <td style="white-space:nowrap;">
                    <div style="display:flex;gap:0.4rem;">
                      <a href={`/brands/${brand.slug}/`} class="card-link" style="font-size:0.8rem;">
                        详情 &rarr;
                      </a>
                      {brand.registerUrl ? (
                        <a
                          href={brand.registerUrl}
                          target="_blank"
                          rel="nofollow sponsored noopener"
                          style="font-size:0.8rem;color:var(--text-secondary);text-decoration:none;"
                        >
                          官网 ↗
                        </a>
                      ) : (
                        <a
                          href="/brands/guangsuyun/"
                          style="font-size:0.78rem;color:var(--accent);text-decoration:none;"
                        >
                          首选替代
                        </a>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 17 家实测截图画廊 -->
  <section class="compare-summary">
    <div class="container">
      <div class="section-header">
        <span class="overline">17 Verified Speedtest Reports · 实测原图档案库</span>
        <h2>二、17 家机场 2026-10 自动化拓扑与峰值测速原图对比</h2>
        <p class="section-desc">
          以下 17 家品牌均附有本站于 2026 年 10 月采集的真实测速与节点拓扑图。点击任意卡片可进入对应品牌的独立评测页查阅高清大图与套餐细节。
        </p>
      </div>

      <div class="compare-cards">
        {measuredBrands.map((brand) => (
          <article class="compare-card" style={`border-top: 3px solid ${brand.accentColor};`}>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
              <span class="blog-tag">#{brand.rank} {brand.name}</span>
              <span style="font-size:0.75rem;color:#10b981;font-weight:700;">
                实测于 {brand.speedtest.screenshotTestedAt}
              </span>
            </div>
            <a href={`/brands/${brand.slug}/`} style="display:block;margin-bottom:0.65rem;">
              <img
                src={brand.speedtest.screenshot}
                alt={`${brand.name} 节点延迟与带宽实测图`}
                loading="lazy"
                style="width:100%;height:175px;object-fit:cover;object-position:top;border-radius:8px;border:1px solid var(--border);"
              />
            </a>
            <h3 style="font-size:1.08rem;margin:0 0 0.25rem;">
              <a href={`/brands/${brand.slug}/`} style="color:inherit;text-decoration:none;">
                {brand.name} ({brand.startingPrice})
              </a>
            </h3>
            <p style="font-size:0.82rem;color:var(--text-secondary);margin:0 0 0.65rem;line-height:1.5;">
              {brand.speedtest.envNote}
            </p>
            <div style="display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:0.65rem;margin-top:auto;gap:0.5rem;">
              <a href={`/brands/${brand.slug}/`} class="card-link" style="white-space:nowrap;">查看高清测速与评测 &rarr;</a>
              {brand.registerUrl && (
                <a
                  href={brand.registerUrl}
                  target="_blank"
                  rel="nofollow sponsored noopener"
                  style="font-size:0.8rem;color:var(--text-secondary);white-space:nowrap;flex-shrink:0;"
                >
                  官网 ↗
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const pills = document.querySelectorAll('#matrix-filter-pills .pill');
      const rows = document.querySelectorAll('#brands-matrix-table tbody .matrix-row');
      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => p.classList.remove('active'));
          pill.classList.add('active');
          const tier = pill.getAttribute('data-tier') || 'all';
          rows.forEach((row) => {
            const tags = (row.getAttribute('data-tags') || '').split(' ');
            row.style.display = tier === 'all' || tags.includes(tier) ? '' : 'none';
          });
        });
      });
    })();
  </script>

  <style>
    .row-top1 {
      background: rgba(34, 211, 238, 0.07);
    }
  </style>
</MarketingLayout>
