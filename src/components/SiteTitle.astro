---
import { SITE_CONFIG } from '../config/site';

const locale = Astro.currentLocale || 'en';
const docsPath = locale === 'en' ? '/docs/' : `/${locale}/docs/`;
---

<div class="site-title-group">
  <a href={docsPath} class="site-title sl-flex">
    <span class="brand-logo" aria-hidden="true"></span>
    <span class="brand-text" translate="no">{SITE_CONFIG.name}</span>
  </a>
  <nav class="title-nav" aria-label="Main site">
    <a href="/">首页</a>
    <a href="/ranking/">机场推荐榜</a>
    <a href="/brands/">42家品牌库</a>
    <a href="/compare/">测速对比</a>
    <a href="/clients/">客户端大全</a>
    <a href={docsPath} aria-current="page">教程百科</a>
    <a href="/blog/">评测专栏</a>
  </nav>
</div>

<style>
  .site-title-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-title {
    align-items: center;
    gap: 0.45rem;
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .brand-logo {
    display: inline-block;
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
    background-color: var(--sl-color-white);
    -webkit-mask-image: url('/assets/brand-mask.svg');
    mask-image: url('/assets/brand-mask.svg');
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  .brand-text {
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }

  .title-nav {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-left: 1.1rem;
    border-left: 1px solid var(--sl-color-hairline);
    font-size: 0.85rem;
  }

  .title-nav a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .title-nav a:hover {
    color: var(--sl-color-white);
  }

  .title-nav a[aria-current="page"] {
    color: var(--sl-color-white);
  }

  @media (max-width: 50rem) {
    .title-nav {
      display: none;
    }
  }
</style>
