---
import { SITE_CONFIG } from '../config/site';

const name = SITE_CONFIG.author.name;
const role = SITE_CONFIG.author.role;
const photo = SITE_CONFIG.author.avatar;
---

<aside class="author-card" aria-label="About the author">
  <img class="author-photo" src={photo} width="72" height="72" alt={name} loading="lazy" decoding="async" />
  <div class="author-body">
    <p class="author-name">{name}</p>
    <p class="author-role">{role}</p>
    <div class="author-links">
      <a href="/brands/" aria-label="42家机场品牌库">
        <span>42家机场品牌库</span>
      </a>
      <a href="/clients/" aria-label="代理客户端大全">
        <span>6大平台客户端大全</span>
      </a>
    </div>
  </div>
</aside>
