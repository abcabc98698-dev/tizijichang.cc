{
  "name": "tiziui-web",
  "version": "1.0.0",
  "description": "TiziUI — Modern static web architecture built with Astro and Starlight.",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-docs": "node scripts/prepare-docs.mjs",
    "clean": "node -e \"const fs=require('fs');['.vercel','dist','build'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "dev": "node scripts/prepare-docs.mjs && astro dev",
    "prebuild": "node -e \"const fs=require('fs');['.vercel','dist','build'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "build": "node scripts/prepare-docs.mjs && astro build",
    "postbuild": "node -e \"const fs=require('fs');if(fs.existsSync('dist/sitemap-index.xml'))fs.copyFileSync('dist/sitemap-index.xml','dist/sitemap.xml');\"",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.5",
    "astro": "^7.3.5"
  }
}
